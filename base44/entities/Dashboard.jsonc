{
  "name": "Dashboard",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "is_public": {
      "type": "boolean",
      "default": false
    },
    "shared_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs with access"
    },
    "layout": {
      "type": "array",
      "description": "Widget layout configuration",
      "items": {
        "type": "object",
        "properties": {
          "widget_id": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number"
          },
          "h": {
            "type": "number"
          }
        }
      }
    },
    "widgets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "bar",
              "line",
              "pie",
              "area",
              "stat_card",
              "table",
              "scatter",
              "heatmap"
            ]
          },
          "title": {
            "type": "string"
          },
          "metric_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "config": {
            "type": "object"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    }
  },
  "required": [
    "title"
  ]
}
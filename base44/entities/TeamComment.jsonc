{
  "name": "TeamComment",
  "type": "object",
  "properties": {
    "page": {
      "type": "string",
      "description": "Page name the comment belongs to"
    },
    "target_key": {
      "type": "string",
      "description": "Optional anchor key for a specific chart, panel, or workbench session"
    },
    "target_label": {
      "type": "string",
      "description": "Human-readable label of the anchored item (e.g. chart title, dataset name)"
    },
    "content": {
      "type": "string",
      "description": "Comment body"
    },
    "author_name": {
      "type": "string"
    },
    "author_email": {
      "type": "string"
    },
    "resolved": {
      "type": "boolean",
      "default": false,
      "description": "Whether the feedback has been addressed"
    }
  },
  "required": [
    "page",
    "content"
  ]
}
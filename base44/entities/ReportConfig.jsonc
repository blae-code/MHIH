{
  "name": "ReportConfig",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Report configuration name"
    },
    "description": {
      "type": "string",
      "description": "Configuration description"
    },
    "metric_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Selected metric IDs"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Selected regions"
    },
    "date_range_type": {
      "type": "string",
      "enum": [
        "last_30_days",
        "last_90_days",
        "last_year",
        "year_to_date",
        "custom"
      ],
      "default": "last_30_days",
      "description": "Date range type"
    },
    "custom_start_date": {
      "type": "string",
      "format": "date",
      "description": "Custom start date if type is custom"
    },
    "custom_end_date": {
      "type": "string",
      "format": "date",
      "description": "Custom end date if type is custom"
    },
    "chart_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "bar",
          "line",
          "area",
          "scatter",
          "pie",
          "heatmap"
        ]
      },
      "description": "Chart types to include"
    },
    "schedule": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly"
      ],
      "description": "Schedule frequency"
    },
    "schedule_day": {
      "type": "string",
      "description": "Day of week for weekly or day of month for monthly"
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Email recipients for automated reports"
    },
    "export_formats": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pdf",
          "csv"
        ]
      },
      "default": [
        "pdf"
      ],
      "description": "Export formats"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused"
      ],
      "default": "active",
      "description": "Configuration status"
    },
    "last_generated": {
      "type": "string",
      "format": "date-time",
      "description": "When the report was last generated"
    }
  },
  "required": [
    "title",
    "metric_ids"
  ]
}
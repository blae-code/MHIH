{
  "name": "Workflow",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "manual",
        "scheduled",
        "on_data_change",
        "on_alert"
      ],
      "default": "manual"
    },
    "trigger_config": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "ai_analysis",
              "export_csv",
              "send_email",
              "run_quality_check",
              "generate_report",
              "sync_source"
            ]
          },
          "label": {
            "type": "string"
          },
          "config": {
            "type": "object"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "draft"
      ],
      "default": "draft"
    },
    "last_run": {
      "type": "string",
      "format": "date-time"
    },
    "run_count": {
      "type": "number",
      "default": 0
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}